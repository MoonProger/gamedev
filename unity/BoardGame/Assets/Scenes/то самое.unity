  m_text: "\u044D\u0442\u043E\u0442 \u043F\u0440\u043E\u0435\u043A\u0442 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u043D\u0430 \u043D\u0435\u0433\u043E - \u0443 \u043D\u0435\u0433\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0435
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0438 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u044F \u043D\u0435 \u0445\u0437 \u043A\u0430\u043A
    \u0432\u044B\u0440\u043E\u0432\u043D\u044F\u0442\u044C \u0442\u0435\u043A\u0441\u0442
    \u043F\u043E \u043A\u0440\u0430\u044F\u043C \u044D\u0442\u043E\u0433\u043E \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0430
